<%- include('../partials/header') %>
<div class="page-head"><h1><%= title %></h1></div>
<% if (typeof error !== 'undefined' && error) { %><div class="flash flash-error"><%= error %></div><% } %>

<form method="post" action="<%= isNew ? '/disposables' : '/disposables/' + d.id %>" class="card stack">
  <%- csrf %>
  <label>Name
    <input name="name" required maxlength="120" value="<%= values.name || '' %>" placeholder="e.g. 1ml syringe, 25G 16mm needle">
  </label>
  <div class="grid-2">
    <label>Category <span class="muted">(optional)</span>
      <input name="category" maxlength="40" list="disp-cats" value="<%= values.category || '' %>">
      <datalist id="disp-cats"><option>Syringes</option><option>Needles</option><option>Swabs</option><option>Sharps</option><option>Dressings</option></datalist>
    </label>
    <label>Counted in
      <input name="unit" maxlength="20" value="<%= values.unit || 'items' %>" placeholder="items">
    </label>
  </div>
  <div class="grid-2">
    <% if (isNew) { %>
      <label>Quantity on hand
        <input type="number" name="quantity" min="0" step="any" value="<%= values.quantity ?? 0 %>">
      </label>
    <% } %>
    <label>Low stock warning at <span class="muted">(optional)</span>
      <input type="number" name="low_stock_threshold" min="0" step="any" value="<%= values.low_stock_threshold ?? '' %>">
    </label>
  </div>
  <label>Notes <span class="muted">(optional)</span>
    <textarea name="notes" rows="2"><%= values.notes || '' %></textarea>
  </label>
  <div class="row-actions">
    <button class="btn btn-primary"><%= isNew ? 'Add supply' : 'Save' %></button>
    <a class="btn btn-ghost" href="<%= isNew ? '/disposables' : '/disposables/' + d.id %>">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>
