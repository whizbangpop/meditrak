<%- include('../partials/header') %>
<div class="page-head">
  <h1><%= showArchived ? 'Archived test types' : 'Blood test types' %></h1>
  <a class="btn btn-primary" href="/bloods/types/new">+ Add</a>
</div>
<p class="muted small">The tests you track, each with its unit and normal range. Ranges vary between labs — copy them from your own results.</p>

<% if (!types.length) { %><section class="card muted">No test types yet.</section><% } %>
<section class="list">
  <% types.forEach(t => { %>
    <a class="card row plain-link" href="/bloods/types/<%= t.id %>">
      <div class="grow">
        <strong><%= t.name %></strong>
        <div class="muted small mono"><%- include('range', { t }) %></div>
      </div>
      <span class="muted small mono"><%= t.n %> result<%= t.n === 1 ? '' : 's' %></span>
    </a>
  <% }) %>
</section>
<p class="center"><a href="/bloods/types<%= showArchived ? '' : '?archived=1' %>" class="muted small"><%= showArchived ? '← Back' : 'Show archived test types' %></a></p>
<p class="center"><a href="/bloods" class="small">← Blood tests</a></p>
<%- include('../partials/footer') %>
