# Public URL the app is served from (must be https for PWA install + push on phones)
BASE_URL=https://meds.example.com
NODE_ENV=production

# Docker: port on the host that maps to the app (change if 3000 is already in use)
HOST_PORT=3000
# Docker: 127.0.0.1 = only reachable from this host (e.g. reverse proxy on the same machine)
HOST_BIND=0.0.0.0
# Docker: user/group the app runs as and that owns ./data (match your host user if you like)
PUID=1000
PGID=1000

# OIDC provider (Authentik, Keycloak, Authelia, Pocket ID, Google, Auth0, Entra ID...)
# Register redirect URI:          ${BASE_URL}/auth/callback
# Post-logout redirect (optional): ${BASE_URL}/login
OIDC_ISSUER=https://auth.example.com/application/o/meditrak/
OIDC_CLIENT_ID=meditrak
OIDC_CLIENT_SECRET=change-me
OIDC_SCOPES=openid profile email
OIDC_PROVIDER_NAME=Authentik

# Optional — generated and stored in DATA_DIR if not set
# SESSION_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact for push services (Apple requires a real mailto: or https URL)
VAPID_SUBJECT=mailto:you@example.com

# Where the SQLite database and generated keys live
DATA_DIR=./data

# Local testing only: adds a name-only sign-in form. Ignored when NODE_ENV=production.
# DEV_LOGIN=true
