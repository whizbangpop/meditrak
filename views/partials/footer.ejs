</main>
<% if (user && profile) { %>
<nav class="tabbar" aria-label="Main">
  <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>Today</span>
  </a>
  <a href="/medications" class="<%= currentPath.startsWith('/medications') || currentPath.startsWith('/stock') || currentPath.startsWith('/schedules') ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="8.5" width="18" height="7" rx="3.5" transform="rotate(-45 12 12)"/><path d="M9.5 9.5l5 5"/></svg><span>Meds</span>
  </a>
  <a href="/disposables" class="<%= currentPath.startsWith('/disposables') ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l4-4M7 13l4 4M8 12l7-7 4 4-7 7zM15 5l2-2M19 9l2-2"/></svg><span>Supplies</span>
  </a>
  <a href="/history" class="<%= currentPath.startsWith('/history') ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14M5 10h14M5 15h10M5 20h7"/></svg><span>History</span>
  </a>
  <a href="/profile" class="<%= currentPath.startsWith('/profile') ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg><span>Profile</span>
  </a>
</nav>
<% } %>
</body>
</html>
