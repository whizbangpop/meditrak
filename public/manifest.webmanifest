{
  "name": "Meditrak",
  "short_name": "Meditrak",
  "description": "Track medications, stock, batches and supplies with reminders.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F2F2F2",
  "theme_color": "#FFFFFF",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Medications", "url": "/medications", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Supplies", "url": "/disposables", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
